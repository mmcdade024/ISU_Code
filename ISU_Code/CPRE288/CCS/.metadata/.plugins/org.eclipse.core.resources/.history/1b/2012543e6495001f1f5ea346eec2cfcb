    //cyBOT_SERVRO_cal_t cal = cyBOT_SERVO_cal();

    left_calibration_value  = 1204000;
    right_calibration_value = 238000;

    cyBOT_Scan_t Scan;

    int i = 0;

    typedef struct{
        int degree;
        int distance;
        int width;
    }Object;

    Object smallest;

    while(1){

        oi_update(sensor_data);

        if(key_pressed == 'm' || key_pressed == 'h'){

            Object objList[20] = {0, 0, 0};

            int PingData[91];
            int IrData[91];

            for (i = 0; i <= 90; i ++){

                cyBOT_Scan(i*2, &Scan);
                //uart_sendStr("Angle: ");
                numToChar(i*2);

                uart_sendStr("    ");

                //uart_sendStr(" PING: ");
                //numToChar(Scan.sound_dist);
                PingData[i] = Scan.sound_dist;

                //uart_sendStr(" IR: ");
                //IrData[i] = (Scan.IR_raw_val * (log(Scan.IR_raw_val / 10) / 100));
                IrData[i] = Scan.IR_raw_val / 10;
                numToChar(IrData[i]);

                uart_sendStr("\n\r");

             }

             i = 0;
             int j = 1;
             int numObj = 0;

             int width = 0;
             int dist  = 0;
             int angle = 0;

             int widthLean   = 5;  // Makes sure that the object has a width greater than it so everything is not considered an obj
             int allowedDifP = 5;  // The min difference between 2 vals allowed for the PING Data
             int allowedDifI = 3;  // The min difference between 2 vals allowed for the IR Data
             int minChange   = 25; // was 80 for the Ping sensor
             int change      = 0;
             int maxDist     = 50; // Maximum distance allowed

             while(i <= 90){

                 if(i < 90 ){
                     if(!change && IrData[j] - IrData[i] >= minChange) { change = 1; } // flip both i's if its using PingData

                     else if(IrData[i] - IrData[j] >= minChange){ change = 0; }
                 }

                 //if(change && abs(PingData[i] - PingData[j]) <= allowedDifP && j <= 90){
                 if(change && j <= 90){

                     width ++;
                     dist  = PingData[(i + j) / 2];
                     angle = (i + j) / 2;
                     j ++;

                 } else {

                     if (width >= widthLean && dist <= maxDist){

                         objList[numObj].degree   = angle;
                         objList[numObj].distance = dist;
                         objList[numObj].width    = width;

                         numObj ++;
                         i = j;

                     }

                     width = 0;
                     j = i;
                     i ++;

                  }

              }

            if (numObj > 0) {

                smallest = objList[0];

                uart_sendStr("Object#   Angle   Distance   Width\n\r");

                for (i = 0; i < numObj; i++){

                    numToChar(i);
                    uart_sendStr("         ");
                    numToChar(objList[i].degree);
                    uart_sendStr("       ");
                    numToChar(objList[i].distance);
                    uart_sendStr("      ");
                    numToChar(objList[i].width);
                    uart_sendStr("         ");

                    uart_sendStr("\n\r");

                    if (objList[i].width < smallest.width){
                        smallest = objList[i];
                    }

                }

                cyBOT_Scan(smallest.degree, &Scan);
                uart_sendStr("the smallest degree is: ");
                numToChar(smallest.degree);
                uart_sendStr("\n\r");

            }

            if(key_pressed == 'h' && numObj > 0){


                uart_sendStr("I plan to rotate to: ");
                numToChar(smallest.degree);
                uart_sendStr("\n\r");

                uart_sendStr("I plan to move forward by: ");
                numToChar(smallest.distance -5);
                uart_sendStr("\n\r");


                key_pressed = 0;

                while(key_pressed == 0);

                if (key_pressed == 'h'){

                    oi_update(sensor_data);

                    int degrees  = 90 - smallest.degree;
                    double angle = 0.0;

                    if (degrees < 0){
                        oi_setWheels(100, -100);
                        degrees *= -1;
                    }else{
                        oi_setWheels(-100, 100);
                    }

                    while (angle < degrees){
                       oi_update(sensor_data);

                       if (sensor_data->angle < 0){
                           angle += sensor_data->angle * -1;
                       }else{
                           angle += sensor_data->angle;
                       }
                    }

                    oi_setWheels(0, 0);

                    while(Scan.sound_dist > 15 && !sensor_data->bumpLeft && !sensor_data->bumpRight){
                        oi_update(sensor_data);
                        cyBOT_Scan(90, &Scan);
                        oi_setWheels(200, 200);

                    }

                    oi_setWheels(0, 0);

                }

            }

        }

        if (key_pressed == 'w'){
            oi_setWheels(200, 200);

        }else if (key_pressed == 's'){
            oi_setWheels(-200, -200);

        }else if (key_pressed == 'a'){
            oi_setWheels(100, -100);

        }else if (key_pressed == 'd'){
            oi_setWheels(-100, 100);

        } else {
            oi_setWheels(0, 0);
        }

        if (key_pressed == 'q'){

            oi_setWheels(0, 0);
            oi_free(sensor_data);

            return;
        }

        key_pressed = 0;

    }


#endif



#endif
}


char singleNumChar(int num){

    switch(num){
        case 1:
            return '1';
        case 2:
            return '2';
        case 3:
            return '3';
        case 4:
            return '4';
        case 5:
            return '5';
        case 6:
            return '6';
        case 7:
            return '7';
        case 8:
            return '8';
        case 9:
            return '9';
        default:
            return '0';
    }

}

void numToChar(int num){

    if (num < 10){ uart_sendChar(singleNumChar(num)); return;}

    int save = num;
    int toSend = 0;
    int numOfDig = 0;

    int i = 0;

    while(save > 0){

       save /= 10;
       numOfDig ++;

    }

    save = num;

    for (i = numOfDig-1; i >= 0; i--){

       toSend = save / pow(10, i);
       save -= toSend * pow(10, i);

       uart_sendChar(singleNumChar(toSend));

    }

}

