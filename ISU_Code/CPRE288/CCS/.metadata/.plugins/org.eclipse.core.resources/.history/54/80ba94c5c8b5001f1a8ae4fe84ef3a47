void getObjs();
void cleanUp();
void sendIrData();
void printIrData();
void getSmallestObj();
void numToChar(int num);


typedef struct{
    int degree;
    int distance;
    int width;
}Object;


volatile Object objList[20] = {0, 0, 0};
volatile Object smallest;
volatile int minWidth = 1; // DONT CHANGE
volatile int closest = 2000; // closest point to CyBot
volatile int IrData[91]; // Holds Ir Values
volatile int numObj = 0; // number of objects
volatile int deg = 0; // degree that the sensor is pointed to
volatile int min = 3; // minium width an obj can be
volatile int i = 0;
volatile int j = 0;


void getIRData(){

    for (i = 0; i <= 90; i ++){

       IrData[i] = adc_read();

       if ( closest > IrData[i] ){ closest = IrData[i]; }

       deg = i*2;
       servo_move(deg);

    }

    printIrData(); // << remove after

}

void getCleanIRData(){

    int add = 0;
    getIRData();

    IrData[0]  = closest;
    i = 0;

    while(i <= 90){

       if (abs(IrData[i++] - IrData[i]) > closest + 50){

           j = i;
           add = 0;

           while(j < 91 && abs(IrData[i-minWidth] - IrData[j+minWidth]) >= closest + 50){
               IrData[++j] = IrData[i];
               add = 1;
           }

           i = j + add;
           IrData[i] = closest;

       } else { IrData[i] = closest; }

    }

    IrData[90] = closest;
    cleanUp();
    sendIrData();
}

void cleanUp(){

    i = 0;
    j = 0;

    while(i < 90){
        j = i;
        while(min+i > j && j < 91){
            ++j;
            if(IrData[i] != IrData[j] && IrData[i] == IrData[i+min+1]){
                IrData[j] = IrData[i];
            }
        }
        i++;
    }
}

void getObjs(){

    int width = 0;
    i = 0;

     while (i <= 90){

         if(i < 90 && IrData[i] > closest){ width ++; }

         else if(width >= min){

            objList[numObj].degree = i*2 - width;
            objList[numObj].distance = IrData[i*2 - width];
            objList[numObj].width = width;

            numObj ++;
            width = 0;

         }

         i ++;
     }

}

void getSmallestObj(){

    getObjs();

    for (i = 0; i < numObj; i++){

        numToChar(i);
        uart_sendStr("         ");
        numToChar(objList[i].degree);
        uart_sendStr("       ");
        numToChar(objList[i].distance);
        uart_sendStr("      ");
        numToChar(objList[i].width);
        uart_sendStr("         ");

        uart_sendStr("\n\r");

        if (objList[i].width < smallest.width){
            smallest = objList[i];
        }

        deg = smallest.degree;
        servo_move(deg);
        uart_sendStr("the smallest degree is: ");
        numToChar(smallest.degree);
        uart_sendStr("\n\r");

    }

}

void sendIrData(){
    i = 0;
    while(i < 91){
        numToChar(i*2);

        uart_sendStr("    ");

        numToChar(IrData[i++]);

        uart_sendStr("\n\r");
    }
    uart_sendStr("\n");

}

void printIrData(){
    i = 0;
    while(i < 91){ printf("%d    %d\n\r", i*2, IrData[i++]); }

}

char singleNumChar(int num){

    switch(num){
        case 1:
            return '1';
        case 2:
            return '2';
        case 3:
            return '3';
        case 4:
            return '4';
        case 5:
            return '5';
        case 6:
            return '6';
        case 7:
            return '7';
        case 8:
            return '8';
        case 9:
            return '9';
        default:
            return '0';
    }

}

void numToChar(int num){

    if (num < 10){ uart_sendChar(singleNumChar(num)); return;}

    int save = num;
    int toSend = 0;
    int numOfDig = 0;

    int i = 0;

    while(save > 0){

       save /= 10;
       numOfDig ++;

    }

    save = num;

    for (i = numOfDig-1; i >= 0; i--){

       toSend = save / pow(10, i);
       save -= toSend * pow(10, i);

       uart_sendChar(singleNumChar(toSend));

    }

}

void keyMove(char keypressed, oi_t *sensor_data){

    getSurfType(sensor_data);
    sendSurfType();

    if(strcmp(getSurfaceType(), "White") == 0){

        // Stop and move backward slightly
        oi_setWheels(0, 0);  // Stop
        //uart_sendStr("White detected! Moving backward...\n\r");
        oi_setWheels(-100, -100);  // Move backward
        timer_waitMillis(500);     // Move for 0.5 seconds
        oi_setWheels(0, 0);        // Stop again
        oi_play_song(1);

    }else if (strcmp(getSurfaceType(), "Black") == 0) {

        // Stop and show black detected message
        oi_setWheels(0, 0);
        //uart_sendStr("Black detected! Stopping robot.\n\r");
        oi_play_song(2);
        timer_waitMillis(3000);   // Wait for the song to finish

    }else{

       if (keypressed == 'm'){
           getCleanIRData();
           //getSmallestObj();

       }if (keypressed == 'w'){
          // oi_setWheels(100, 100);
           oi_setWheels(105, 100);

       }else if (keypressed == 's'){
           oi_setWheels(-100, -100);

       }else if (keypressed == 'a'){
           oi_setWheels(100, -100);

       }else if (keypressed == 'd'){
           oi_setWheels(-100, 100);

       }

       timer_waitMillis(100);
       oi_setWheels(0, 0);

       if (key_pressed == 'q'){

           oi_setWheels(0, 0);
           oi_free(sensor_data);

           return;
        }

       key_pressed = 0;

    }

}
