typedef struct{
    int degree;
    int distance;
    int width;
}Object;


volatile Object objList[20] = {0, 0, 0};
volatile Object smallest;
volatile int minWidth = 2; // DONT CHANGE
volatile int closest = 2000; // closest point to CyBot

volatile int IrData[91]; // Holds Ir Values
volatile int PingData[91];
volatile int numObj = 0; // number of objects
volatile int deg = 0; // degree that the sensor is pointed to
volatile int min = 3; // minium width an obj can be
volatile int i = 0;
volatile int j = 0;


void getIRData(){

    cyBOT_Scan_t Scan;

    for (i = 0; i <= 90; i ++){

       cyBOT_Scan(i*2, &Scan);

       IrData[i] = Scan.IR_raw_val / 10;
       PingData[i] = Scan.sound_dist;

       if ( closest > IrData[i] ){ closest = IrData[i]; }

       deg = i*2;
       //servo_move(deg);

    }

}

void getCleanIRDataV2(){

    getIRData();

    int change    = 0;
    int saveVal   = 0;

    IrData[0] = closest;
    i = 0;

    // put the -10 because the value for the difference was to high was a guessed value
    while(i <= 90){

        if (abs(IrData[i] - IrData[i ++]) >= closest){ change = !change; saveVal = IrData[i]; }
        else { IrData[i] = closest; }

        if(change){ IrData[i] = saveVal; }

    }

    cleanUp();
    sendIrData();

}

void getCleanIRData(){

    int add = 0;
    getIRData();

    i = 0;

    while(i <= 90){

       if (abs(IrData[i++] - IrData[i]) > closest + 50){

           j = i;
           add = 0;

           while(j < 91 && abs(IrData[j] - IrData[j+minWidth]) <= 200 + closest){ //<< was IrData[i] - IrData[j+minWidth] (-1) also >= closest + 50
               IrData[++j] = IrData[i];
               add = 1;
           }

           i = j + add;
           IrData[i] = closest;

       } else { IrData[i] = closest; }

    }

    IrData[0]  = closest;
    IrData[90] = closest;
    cleanUp();
    sendIrData();
}

void getCleanPingData(){

    int add = 0;
    getIRData();

    i = 0;

    while(i <= 90){

       if (abs(PingData[i++] - PingData[i]) > closest + 50){

           j = i;
           add = 0;

           while(j < 91 && abs(PingData[j] - PingData[j+minWidth]) >= closest){ //<< was IrData[i] - IrData[j+minWidth] (-1) also >= closest + 50
               PingData[++j] = PingData[i];
               add = 1;
           }


           i = j + add;
           PingData[i] = closest;

       } else { PingData[i] = closest; }

    }

    PingData[0]  = closest;
    PingData[90] = closest;
    cleanUp();
    sendIrData();
}

void cleanUp(){

    i = 0;
    j = 0;

    while(i < 90){
        j = i;
        while(min+i > j && j < 91){
            ++j;
            if(IrData[i] != IrData[j] && IrData[i] == IrData[i+min+1]){
                IrData[j] = IrData[i];
            }
        }
        i++;
    }
}

void getObjs(){

    int width = 0;
    i = 0;

     while (i <= 90){

         if(i < 90 && IrData[i] > closest){ width ++; }

         else if(width >= min){

            objList[numObj].degree = i*2 - width;
            objList[numObj].distance = IrData[i*2 - width];
            objList[numObj].width = width;

            numObj ++;
            width = 0;

         }

         i ++;
     }

}

void getSmallestObj(){

    getObjs();

    for (i = 0; i < numObj; i++){

        numToChar(i);
        uart_sendStr("         ");
        numToChar(objList[i].degree);
        uart_sendStr("       ");
        numToChar(objList[i].distance);
        uart_sendStr("      ");
        numToChar(objList[i].width);
        uart_sendStr("         ");

        uart_sendStr("\n\r");

        if (objList[i].width < smallest.width){
            smallest = objList[i];
        }

        deg = smallest.degree;
        //servo_move(deg);
        uart_sendStr("the smallest degree is: ");
        numToChar(smallest.degree);
        uart_sendStr("\n\r");

    }

}

void sendIrData(){
    i = 0;
    while(i < 91){
        numToChar(i*2);

        uart_sendStr("    ");

        numToChar(IrData[i++]);

        uart_sendStr("\n\r");
    }
    uart_sendStr("\n");

}

void printIrData(){
    i = 0;
    while(i < 91){ printf("%d    %d\n\r", i*2, IrData[i++]); }

}

char singleNumChar(int num){

    switch(num){
        case 1:
            return '1';
        case 2:
            return '2';
        case 3:
            return '3';
        case 4:
            return '4';
        case 5:
            return '5';
        case 6:
            return '6';
        case 7:
            return '7';
        case 8:
            return '8';
        case 9:
            return '9';
        default:
            return '0';
    }

}

void numToChar(int num){

    if (num < 10){ uart_sendChar(singleNumChar(num)); return;}

    int save = num;
    int toSend = 0;
    int numOfDig = 0;

    int i = 0;

    while(save > 0){

       save /= 10;
       numOfDig ++;

    }

    save = num;

    for (i = numOfDig-1; i >= 0; i--){

       toSend = save / pow(10, i);
       save -= toSend * pow(10, i);

       uart_sendChar(singleNumChar(toSend));

    }

}

void keyMove(char keypressed, oi_t *sensor_data){

// CyBot 10
    getSurfType(sensor_data);

    oi_update(sensor_data);

    if(strcmp(getSurfaceType(), "White") == 0){

        // Stop and move backward slightly
        oi_setWheels(0, 0);  // Stop
        uart_sendStr("white\n");
        oi_setWheels(-100, -100);  // Move backward
        timer_waitMillis(500);     // Move for 0.5 seconds
        oi_setWheels(0, 0);        // Stop again
        oi_play_song(2);

    }else if (strcmp(getSurfaceType(), "Black") == 0) {

        // Stop and show black detected message
        oi_setWheels(0, 0);
        uart_sendStr("black\n");
        oi_play_song(1);
        timer_waitMillis(3000);   // Wait for the song to finish

//------------------------------------ Bump sensors ------------------------------------

    }else if(sensor_data->bumpLeft){
        oi_setWheels(0, 0);
        oi_play_song(4);
        uart_sendStr("left\n");
        oi_setWheels(-100, -100);
        timer_waitMillis(550);
        oi_setWheels(0, 0);

    }else if(sensor_data->bumpRight){
        oi_setWheels(0, 0);
        oi_play_song(3);
        uart_sendStr("right\n");
        oi_setWheels(-100, -100);
        timer_waitMillis(550);
        oi_setWheels(0, 0);

    }else{

       if (keypressed == 'm'){
           getCleanIRDataV2();
           //getSmallestObj();
           //uart_sendStr("junk_M\n"); // << dont remove or GUI will get stuck at readline

       }if (keypressed == 'w'){
           oi_setWheels(100, 100);
           timer_waitMillis(1000);
           //uart_sendStr("junk_W\n"); // << dont remove or GUI will get stuck at readline

       }else if (keypressed == 's'){
           oi_setWheels(-100, -100);
           timer_waitMillis(1000);
           //uart_sendStr("junk_S\n"); // << dont remove or GUI will get stuck at readline

       }else if (keypressed == 'a'){
           oi_setWheels(100, -100);
           timer_waitMillis(200);
           //uart_sendStr("junk_A\n"); // << dont remove or GUI will get stuck at readline

       }else if (keypressed == 'd'){
           oi_setWheels(-100, 100);
           timer_waitMillis(200);
           //uart_sendStr("junk_D\n"); // << dont remove or GUI will get stuck at readline

       }

       oi_setWheels(0, 0);

       if (key_pressed == 'q'){

           oi_setWheels(0, 0);
           oi_free(sensor_data);

           return;
        }

    }

    timer_waitMillis(60);
    uart_sendStr("junk\n");

}
