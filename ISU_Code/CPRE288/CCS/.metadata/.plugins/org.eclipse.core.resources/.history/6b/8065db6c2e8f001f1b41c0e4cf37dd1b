char singleNumChar(int num){

    switch(num){
        case 1:
            return '1';
        case 2:
            return '2';
        case 3:
            return '3';
        case 4:
            return '4';
        case 5:
            return '5';
        case 6:
            return '6';
        case 7:
            return '7';
        case 8:
            return '8';
        case 9:
            return '9';
        default:
            return '0';
    }

}

char* numToChar(int num){

    if (num == 0){ return "0"; }

    int toMultiply = 1;
    int toSubtract = 0;
    int saveNum    = num;
    int numDig     = 0;

    int i = 0;

    do
    {

        toSubtract = saveNum % toMultiply;

        saveNum -= toSubtract;
        toMultiply *= 10;
        numDig ++;

    } while(saveNum > 0);

    numDig --;
    saveNum = num;
    toSubtract = 0;
    toMultiply = 1;

    char strOfNum [numDig];

    strOfNum[numDig] = '\0';

    for(i = numDig-1; 0 <= i; i--){

        toMultiply *= 10;

        toSubtract  = saveNum % toMultiply;

        saveNum    -= toSubtract;

        strOfNum[i] = singleNumChar(toSubtract / (toMultiply/10));


    }

    return *strOfNum;

}

